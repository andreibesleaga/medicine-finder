# Medicine Brand Finder: server settings (Railway service variables).
# Copy to .env for local runs: `npm run build && node --env-file=.env server/index.js`
# Never commit .env. None of these values reach the browser.

# --- AI providers (optional; each one is used only when its key is set) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEY=
# default "openrouter/free" picks an available free model; a comma-separated list = fallbacks
# OPENROUTER_MODEL=openrouter/free

# --- Keyed sources (optional; each is off until its key is set) ---
# openFDA labels queried by the server (120,000 calls a day; free key at https://open.fda.gov/apis/authentication/).
# Without it the browser asks openFDA itself (1,000 calls a day per visitor address).
# OPENFDA_API_KEY=

# --- Canada ---
# dataset (default: Health Canada's monthly extract, always answers) | live (API per search) | both | off
# HEALTH_CANADA=dataset

# --- Files imported by hand ---
# Finland: put Perusrekisteri.xml in $DATA_DIR/imports (see docs/DEPLOY.md)

# --- Limits ---
# total AI provider calls per day (UTC), across all users
# AI_DAILY_LIMIT=500
# AI requests per minute per visitor, and how long an AI answer is cached
# AI_RATE_LIMIT=10
# AI_CACHE_SECONDS=86400
# searches per minute per visitor
# SEARCH_RATE_LIMIT=20
# how long a search answer is cached (in memory and in the database, so it survives restarts)
# SEARCH_CACHE_SECONDS=3600
# searches and AI requests per minute for all visitors together (a cap forged addresses cannot get round)
# GLOBAL_SEARCH_RATE_LIMIT=300
# GLOBAL_AI_RATE_LIMIT=60
# false on a host with no proxy in front (Railway sets X-Real-IP): the limits then ignore X-Forwarded-For
# TRUST_FORWARDED_FOR=true
# how many of the most searched terms (last 30 days) are searched again once a day; 0 = off
# WARM_TERMS=50

# --- Only for a separate static frontend (e.g. Vercel) that calls this server ---
# ALLOWED_ORIGINS=https://medicine-finder.vercel.app

# PORT is set by Railway; defaults to 8080 locally.

# --- Build-time switches for the frontend (Vite), used only by a Vercel build ---
# VITE_API_BASE=https://medicine-finder.up.railway.app
# VITE_VERCEL_ANALYTICS=true
